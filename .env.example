# Local development settings. Copy to .env (gitignored) and adjust:
#   Copy-Item .env.example .env
# These are dev-only passwords for the local compose stack (bound to 127.0.0.1).
# On the VPS the real values live in a server-side .env, never in git.

# --- rmx-server -----------------------------------------------------------
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://app:db-dev@127.0.0.1:55432/app
MQTT_HOST=127.0.0.1
MQTT_PORT=11883
MQTT_USERNAME=app
MQTT_PASSWORD=app-dev
# Pages allowed to log in, change data and open the WebSocket (CSRF check):
# the Bun dev server, and rmx-server itself when it serves the built client.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
# debug, info, warn or error (default info)
LOG_LEVEL=info
# Firmware images served over MQTT, in the subdirectories gateway/ and
# autopilot/ (<version>.bin each). Unset: no firmware is served.
# dev/run.ps1 sets dev/firmware (gitignored) when this is unset.
# FIRMWARE_DIR=
# Path files (<path>.json) served to the autopilot. Unset: none are served.
# dev/run.ps1 sets dev/paths (gitignored) when this is unset.
# PATH_FILE_DIR=
# The NTRIP caster the server tells every gateway to use (ntrip_set). All of
# host, mountpoint, user and password, or none. Real values only in a local
# .env or on the VPS, never in git.
# NTRIP_HOST=
# NTRIP_PORT=2101
# NTRIP_MOUNTPOINT=
# NTRIP_USER=
# NTRIP_PASSWORD=

# --- dev/run.ps1 -------------------------------------------------------------
# The login dev/run.ps1 creates in the dev database (12+ characters).
DEV_USER=dev
DEV_PASSWORD=dev-password-123
# Name of the simulated device (cmd/devsim), mower/<name>/...
DEVSIM_NAME=mower-sim

# --- compose.dev.yaml -------------------------------------------------------
POSTGRES_PASSWORD=db-dev
# Password of the MQTT login test-device (a device, used by the integration tests).
TEST_DEVICE_PASSWORD=test-device-dev
