# Local development settings. Copy to .env (gitignored) and adjust:
#   Copy-Item .env.example .env
# These are dev-only passwords for the local compose stack (bound to 127.0.0.1).
# On the VPS the real values live in a server-side .env, never in git.

# --- rmx-server -----------------------------------------------------------
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://app:db-dev@127.0.0.1:55432/app
MQTT_HOST=127.0.0.1
MQTT_PORT=11883
MQTT_USERNAME=app
MQTT_PASSWORD=app-dev
# Pages allowed to log in, change data and open the WebSocket (CSRF check):
# the Bun dev server, and rmx-server itself when it serves the built client.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
# debug, info, warn or error (default info)
LOG_LEVEL=info
# Directory of *.bin firmware images served over MQTT. Unset: firmware
# requests are not served. FIRMWARE_CHUNK_BYTES defaults to 4096 (256..16384).
# FIRMWARE_DIR=
# FIRMWARE_CHUNK_BYTES=4096

# --- compose.dev.yaml -------------------------------------------------------
POSTGRES_PASSWORD=db-dev
# Password of the MQTT login test-device (a device, used by the integration tests).
TEST_DEVICE_PASSWORD=test-device-dev
